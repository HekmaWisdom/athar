# Athar (apps/web) — environment variables
# Copy this file to `.env` in this same folder and fill in real values.
# `.env` is gitignored — never commit it. See ../SETUP.md for where to get each value.

# ── Supabase (project: wydnzsgepqqdqibxgyea) ────────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/wydnzsgepqqdqibxgyea/settings/api
# Server-side copies (used by src/integrations/supabase/client.server.ts,
# auth-middleware.ts — SSR/server-function code, no VITE_ prefix so they're
# never bundled into client JS):
SUPABASE_PROJECT_ID="wydnzsgepqqdqibxgyea"
SUPABASE_URL="https://wydnzsgepqqdqibxgyea.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
# Secret — service role bypasses RLS. Server-only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# Client-side copies (same values, VITE_ prefix = Vite inlines these into the
# browser bundle at build time — fine for URL + publishable key, NEVER put the
# service role key behind a VITE_ prefix):
VITE_SUPABASE_PROJECT_ID="wydnzsgepqqdqibxgyea"
VITE_SUPABASE_URL="https://wydnzsgepqqdqibxgyea.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# One key pair for the whole app — reuse the existing pair, don't regenerate
# (regenerating invalidates every user's existing push subscription).
# Generate a NEW pair only for a brand-new deployment: `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY="BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# This one is also required as a Supabase Edge Function *secret* (not just here) —
# see supabase/functions/send-daily-reminders/index.ts header comment and
# SETUP.md "Push notifications" section. Keep both copies in sync.
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# No AI API keys are needed: quote explanations are hand-curated in the DB
# (edited via /admin), by design, to avoid any API cost.
